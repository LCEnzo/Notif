# Caddy reverse proxy for Notif
# ────────────────────────────────────────────────────────────────
# Caddy auto-obtains and renews TLS certificates from Let's Encrypt.
# Configure NOTIF_DOMAIN in the environment, or edit the default below.
#
#   Docker: docker compose -f compose.yaml --profile prod up -d
#   Bare:   cp Caddyfile /etc/caddy/ && systemctl reload caddy
#
# Changes take effect after Caddy is reloaded or restarted.
# ────────────────────────────────────────────────────────────────

# Global options
# ----------------------------------------------------------------
# Trust Cloudflare's proxy IPs and use CF-Connecting-IP as the real client
# IP. Harmless when the DNS record is grey-cloud (no traffic comes from
# these ranges). Update this list if Cloudflare publishes new ranges:
# https://www.cloudflare.com/ips/
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

{$NOTIF_DOMAIN:notif.lcenzo.com} {
	log {
		output file {$CADDY_ACCESS_LOG:/var/log/caddy/access.json} {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}

	# API — reverse proxy to Django/gunicorn.
	# Docker default: backend:8000
	# Bare override:  BACKEND_UPSTREAM=localhost BACKEND_PORT=8000
	handle /api/* {
		reverse_proxy {$BACKEND_UPSTREAM:localhost}:{$BACKEND_PORT:8000}
	}

	# Django static files — served directly from disk, zero Python overhead.
	# Docker default: /app/staticfiles
	# Bare default:   /opt/notif/backend/staticfiles
	handle /static/* {
		root * {$STATIC_ROOT:/opt/notif/backend/staticfiles}
		file_server
	}

	# Django admin — proxied to backend so it isn't swallowed by the SPA
	# fallback below. The path is controlled by DJANGO_ADMIN_ROUTE
	# (defaults to /admin/*, matching the DJANGO_ADMIN_URL setting).
	handle {$DJANGO_ADMIN_ROUTE:/admin/*} {
		reverse_proxy {$BACKEND_UPSTREAM:localhost}:{$BACKEND_PORT:8000}
	}

	# Flutter web app — SPA fallback: unknown routes serve index.html
	# so that Flutter's client-side router handles deep links.
	# Docker default: /app/frontend
	handle {
		root * {$FRONTEND_ROOT:/app/frontend}

		# Flutter's entry files change on every build but live at fixed,
		# unhashed URLs. Without Cache-Control, Cloudflare's default edge
		# TTL (4h for .js) can serve a stale bundle — or a service worker
		# mismatched with its main.dart.js — long after a deploy. no-cache
		# means store-but-revalidate: with the etag file_server already
		# emits, an unchanged file costs a 304, and a deploy is visible on
		# the next request.
		@mutable_entry path / /index.html /flutter_bootstrap.js /flutter.js /main.dart.js /flutter_service_worker.js /version.json /manifest.json
		header @mutable_entry Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}

# Apex + www — landing page. Anything other than the root path falls
# through to the styled 404 (so the apex doesn't 200 every random URL).
lcenzo.com, www.lcenzo.com {
	tls {$FALLBACK_TLS_CERT:/etc/caddy/origin-certs/lcenzo.com.pem} {$FALLBACK_TLS_KEY:/etc/caddy/origin-certs/lcenzo.com.key}

	root * {$FALLBACK_ROOT:/opt/notif/deploy/fallback}

	handle / {
		rewrite * /index.html
		file_server
	}

	handle {
		rewrite * /not-found.html
		file_server {
			status 404
		}
	}
}

# Self-hosted F-Droid repo; deploy/fdroid/notif-apk publishes into it.
# Docker default: /srv/fdroid (compose mounts /srv/notif-fdroid/repo there)
# Bare default:   /srv/notif-fdroid
#
# The index files are no-cache: entry.jar pins index-v2.json by hash, so a
# stale edge copy of either hides an update or fails verification in the
# client. index.jar and index.xml are the v0 index fdroidserver 2.4.2 still
# writes; /repo/ is index.html. An APK URL never changes content (publish
# refuses to overwrite one), so APKs are cacheable for good.
fdroid.lcenzo.com {
	tls {$FALLBACK_TLS_CERT:/etc/caddy/origin-certs/lcenzo.com.pem} {$FALLBACK_TLS_KEY:/etc/caddy/origin-certs/lcenzo.com.key}

	root * {$FDROID_ROOT:/srv/notif-fdroid}

	@index path /repo/entry.jar /repo/entry.json /repo/index-v1.jar /repo/index-v1.json /repo/index-v2.json /repo/diff/* /repo/index.jar /repo/index.xml /repo/ /repo/index.html /repo/index.png
	header @index Cache-Control "no-cache"

	# Only existing APKs: a 404 marked immutable would stay at the edge for a year.
	@apk {
		path *.apk
		file
	}
	header @apk Cache-Control "public, max-age=31536000, immutable"

	file_server
}

# Wildcard catch-all for any other lcenzo.com hostname that isn't
# notif.lcenzo.com or fdroid.lcenzo.com (own blocks above). Always 404.
*.lcenzo.com {
	tls {$FALLBACK_TLS_CERT:/etc/caddy/origin-certs/lcenzo.com.pem} {$FALLBACK_TLS_KEY:/etc/caddy/origin-certs/lcenzo.com.key}

	root * {$FALLBACK_ROOT:/opt/notif/deploy/fallback}
	rewrite * /not-found.html
	file_server {
		status 404
	}
}
