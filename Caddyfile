# Caddy reverse proxy for Notif
# ────────────────────────────────────────────────────────────────
# Caddy auto-obtains and renews TLS certificates from Let's Encrypt.
# Configure NOTIF_DOMAIN in the environment, or edit the default below.
#
#   Docker: docker compose -f compose.yaml --profile prod up -d
#   Bare:   cp Caddyfile /etc/caddy/ && systemctl reload caddy
#
# Changes take effect after Caddy is reloaded or restarted.
# ────────────────────────────────────────────────────────────────

# Global options
# ----------------------------------------------------------------
# Trust Cloudflare's proxy IPs and use CF-Connecting-IP as the real client
# IP. Harmless when the DNS record is grey-cloud (no traffic comes from
# these ranges). Update this list if Cloudflare publishes new ranges:
# https://www.cloudflare.com/ips/
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$NOTIF_DOMAIN:notif.example.com} {
	# Serve static files directly from disk — never touches Python.
	# Docker default: /app/staticfiles
	# Bare default:   /opt/notif/backend/staticfiles
	handle /static/* {
		root * {$STATIC_ROOT:/opt/notif/backend/staticfiles}
		file_server
	}

	# Everything else → gunicorn/Django.
	# Docker default: backend:8000
	# Bare override:  BACKEND_UPSTREAM=localhost BACKEND_PORT=8000
	handle {
		reverse_proxy {$BACKEND_UPSTREAM:localhost}:{$BACKEND_PORT:8000}
	}
}
