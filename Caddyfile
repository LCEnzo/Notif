# Caddy reverse proxy for Notif
# ────────────────────────────────────────────────────────────────
# Caddy auto-obtains and renews TLS certificates from Let's Encrypt.
# Replace the domain below with yours, then:
#
#   Docker:    mount as /etc/caddy/Caddyfile:ro (see deploy.md)
#   Bare:      cp Caddyfile /etc/caddy/ && systemctl reload caddy
#
# Caddy reads this once at startup / reload — no restart needed.
# ────────────────────────────────────────────────────────────────

notif.example.com {
	# Serve static files directly from disk — never touches Python.
	# Docker: /app/staticfiles    Bare metal: /opt/notif/backend/staticfiles
	handle /static/* {
		root * /opt/notif/backend/staticfiles
		file_server
	}

	# Everything else → gunicorn on localhost:8000
	handle {
		reverse_proxy localhost:8000
	}
}
