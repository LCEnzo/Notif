<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup and transfer rules.

  Everything is excluded from both channels. The app stores a refresh token
  (keystore-encrypted) and session state; restoring either onto another device
  would recreate a live session there. There is nothing in this app's data worth
  backing up, so the safe rule is also the simple one.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
