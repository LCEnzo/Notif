#!/usr/bin/env python3
"""notif-apk: set up the self-hosted F-Droid repo on the VPS, build Notif APKs,
and publish them to it. Runbook: docs/operations/fdroid_runbook.md

Runs on the VPS as a docker-group user; `setup` also uses sudo. Standard library
only. Fixed locations, overridable for tests:
  NOTIF_FDROID_KEYS    /etc/notif/fdroid         apk.p12, apk.pass, repo-index.p12, repo-index.pass
  NOTIF_FDROID_DATA    /srv/notif-fdroid         repo/ is what Caddy serves
  NOTIF_APK_WORK       ~/.cache/notif-apk        throwaway worktrees and build output
  NOTIF_APK_LINK       /usr/local/bin/notif-apk  the link `setup` points at this file
  NOTIF_FDROID_PICKUP  ~/notif-fdroid-keys.tar   the key backup `export-keys` writes
"""

import io
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
from collections.abc import Mapping, Sequence
from dataclasses import dataclass
from pathlib import Path
from types import FrameType
from typing import IO, ClassVar, NoReturn, Protocol, Self, assert_never

# POSIX-only; guarded so that the unit tests can import this file on Windows.
if sys.platform != "win32":
	import fcntl

USAGE = """\
Usage:
  notif-apk setup [--restore <tar>]
                             Create the F-Droid directories, this command's link
                             and the publish image; generate, restore or verify
                             the signing keys. ./deploy.sh runs it every time.
  notif-apk build [commit]   Build <commit> (default: origin/master after a fetch)
                             as a signed arm64 APK, then publish it.
  notif-apk publish <apk>    Check a signed APK and add it to the F-Droid repo.
  notif-apk export-keys      Write the signing keys to ~/notif-fdroid-keys.tar,
                             for deploy/fdroid/backup-keys.sh to copy off.
"""

BUILD_IMAGE = "notif-apk-build"
PUBLISH_IMAGE = "notif-apk-publish"
APK_PIN = "apk-cert.sha256"
REPO_PIN = "repo-index-cert.sha256"
HEX64 = re.compile(r"[0-9a-f]{64}")
# sed's and tr's [[:space:]] within a line, in the C locale.
_PIN_COMMENT = re.compile(r"[ \t\r\v\f]*#")
_PIN_SPACE = re.compile(r"[ \t\r\v\f]")


class FatalError(Exception):
	"""Ends notif-apk with `notif-apk: <message>` on stderr and exit 1."""


class CommandError(Exception):
	"""A command failed; notif-apk exits with its status, as `set -e` did."""

	def __init__(self, status: int) -> None:
		super().__init__(status)
		self.status = status


class Interrupted(BaseException):
	"""HUP, INT or TERM; notif-apk exits 128 + the signal number after cleanup."""

	def __init__(self, signum: int) -> None:
		super().__init__(signum)
		self.signum = signum


def die(message: str) -> NoReturn:
	raise FatalError(message)


def info(message: str) -> None:
	print(f"notif-apk: {message}")


def warn(message: str) -> None:
	print(f"notif-apk: warning: {message}", file=sys.stderr)


@dataclass(frozen=True)
class Paths:
	script: Path
	keys_dir: Path
	data_dir: Path
	work_root: Path
	link: Path
	pickup: Path

	@property
	def fdroid_dir(self) -> Path:
		return self.script.parent

	@property
	def checkout(self) -> Path:
		return self.script.parents[2]

	@property
	def repo_dir(self) -> Path:
		return self.data_dir / "repo"

	@classmethod
	def from_env(cls, script: Path, environ: Mapping[str, str]) -> Self:
		# An empty variable counts as unset, like the shell's ${VAR:-default}.
		def env(name: str) -> str | None:
			return environ.get(name) or None

		home = Path(env("HOME") or Path.home())
		cache = Path(env("XDG_CACHE_HOME") or home / ".cache")
		return cls(
			script=script,
			keys_dir=Path(env("NOTIF_FDROID_KEYS") or "/etc/notif/fdroid"),
			data_dir=Path(env("NOTIF_FDROID_DATA") or "/srv/notif-fdroid"),
			work_root=Path(env("NOTIF_APK_WORK") or cache / "notif-apk"),
			link=Path(env("NOTIF_APK_LINK") or "/usr/local/bin/notif-apk"),
			pickup=Path(env("NOTIF_FDROID_PICKUP") or home / "notif-fdroid-keys.tar"),
		)


@dataclass(frozen=True)
class Pins:
	apk: str
	repo: str


def pin_text(text: str) -> str:
	"""A pin file without comment lines (optional whitespace, then `#`) and without
	any whitespace, as `sed '/^[[:space:]]*#/d' | tr -d '[:space:]'` leaves it."""
	kept = "".join(line for line in text.split("\n") if not _PIN_COMMENT.match(line))
	return _PIN_SPACE.sub("", kept)


def parse_pin(text: str) -> str:
	"""The digest in a pin file, or "" while unset; raises ValueError unless
	what pin_text leaves is empty or 64 lowercase hex digits."""
	pin = pin_text(text)
	if pin and not HEX64.fullmatch(pin):
		raise ValueError(f"not 64 lowercase hex digits: {pin!r}")
	return pin


@dataclass(frozen=True)
class Absent:
	word: ClassVar[str] = "absent"


@dataclass(frozen=True)
class Partial:
	files: str
	word: ClassVar[str] = "partial"


@dataclass(frozen=True)
class Present:
	apk: str
	repo: str
	word: ClassVar[str] = "present"


type KeyState = Absent | Partial | Present


def parse_inspection(out: str) -> KeyState:
	"""Parses `container_keys.py inspect`; raises ValueError on anything else."""
	match out.split():
		case ["absent"]:
			return Absent()
		case ["partial", *files] if files:
			return Partial(" ".join(files))
		case ["present", apk, repo] if HEX64.fullmatch(apk) and HEX64.fullmatch(repo):
			return Present(apk, repo)
		case _:
			raise ValueError(f"unexpected inspection output: {out!r}")


class Host(Protocol):
	def call(self, argv: Sequence[str], *, stdin: IO[bytes] | None = None, stdout: int | None = None) -> int: ...

	def capture(self, argv: Sequence[str]) -> tuple[int, str]: ...

	def lock(self, directory: Path) -> bool: ...

	def hold_signals(self) -> None: ...


def exit_status(returncode: int) -> int:
	# Popen reports death by signal N as -N; a shell reports 128 + N.
	return returncode if returncode >= 0 else 128 - returncode


class LocalHost:
	"""Runs commands like the shell version: in the foreground, with this
	process's stdio. HUP, INT and TERM are recorded, never raised from the
	handler: a running command is waited for (Ctrl-C reached it too, and docker
	forwards it to the container), and no further command starts. notif-apk then
	unwinds through its `finally` cleanups and exits 128 + N."""

	def __init__(self) -> None:
		self.pending: int | None = None
		self._holding = False
		self._lock_fds: tuple[int, ...] = ()

	def install_signal_handlers(self) -> None:
		for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
			signal.signal(signum, self._on_signal)

	def _on_signal(self, signum: int, _frame: FrameType | None) -> None:
		if self.pending is None:
			self.pending = signum

	def hold_signals(self) -> None:
		"""For cleanup: commands run despite a pending signal; run() exits with it afterwards."""
		self._holding = True

	def _check_signal(self) -> None:
		if self.pending is not None and not self._holding:
			raise Interrupted(self.pending)

	def _run(self, argv: Sequence[str], stdin: IO[bytes] | None, stdout: int | None) -> tuple[int, bytes | None]:
		self._check_signal()
		# Only docker gets the lock: a docker run outliving a killed notif-apk keeps
		# it, while a detached `git gc --auto` from git fetch does not.
		fds = self._lock_fds if argv[0] == "docker" else ()
		try:
			proc = subprocess.Popen(argv, stdin=stdin, stdout=stdout, pass_fds=fds)
		except FileNotFoundError:
			print(f"notif-apk: {argv[0]}: command not found", file=sys.stderr)
			return 127, None
		out, _ = proc.communicate()
		self._check_signal()
		return exit_status(proc.returncode), out

	def call(self, argv: Sequence[str], *, stdin: IO[bytes] | None = None, stdout: int | None = None) -> int:
		status, _ = self._run(argv, stdin, stdout)
		return status

	def capture(self, argv: Sequence[str]) -> tuple[int, str]:
		status, out = self._run(argv, None, subprocess.PIPE)
		return status, (out or b"").decode("utf-8", "replace").rstrip("\n")

	def lock(self, directory: Path) -> bool:
		"""flock(2) on the directory, like flock(1). docker commands inherit the
		descriptor, so a killed notif-apk keeps the lock until its docker run
		ends. False if another process holds it."""
		fd = os.open(directory, os.O_RDONLY)
		try:
			fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
		except BlockingIOError:
			os.close(fd)
			return False
		os.set_inheritable(fd, True)  # noqa: FBT003 - positional-only builtin
		self._lock_fds = (*self._lock_fds, fd)
		return True


class NotifApk:
	def __init__(self, paths: Paths, host: Host, *, as_root: bool) -> None:
		self.paths = paths
		self.host = host
		self.as_root = as_root

	# Same convention as deploy.sh.
	def sudo(self, argv: Sequence[str]) -> None:
		self.check([*argv] if self.as_root else ["sudo", *argv])

	def check(self, argv: Sequence[str]) -> None:
		status = self.host.call(argv)
		if status != 0:
			raise CommandError(status)

	def git(self, *args: str) -> tuple[int, str]:
		return self.host.capture(["git", "-C", str(self.paths.checkout), *args])

	def pin_value(self, name: str) -> str:
		file = self.paths.fdroid_dir / "pins" / name
		if not file.is_file():
			die(f"refused: pin file deploy/fdroid/pins/{name} does not exist")
		try:
			text = file.read_bytes().decode("utf-8", "replace")
		except OSError as e:
			die(f"refused: cannot read deploy/fdroid/pins/{name}: {e.strerror}")
		try:
			return parse_pin(text)
		except ValueError:
			die(f"refused: deploy/fdroid/pins/{name} is not a lowercase SHA-256 hex digest")

	def read_pins(self) -> Pins | None:
		"""Both pins, or None before the first-ever setup."""
		apk = self.pin_value(APK_PIN)
		repo = self.pin_value(REPO_PIN)
		if bool(apk) != bool(repo):
			die(
				"refused: only one of deploy/fdroid/pins/{apk-cert,repo-index-cert}.sha256 has a value;"
				" set both or neither"
			)
		return Pins(apk, repo) if apk else None

	def require_pins(self) -> Pins:
		pins = self.read_pins()
		if pins is None:
			die("refused: pin missing: deploy/fdroid/pins/*.sha256 have no value (runbook: first-ever setup)")
		return pins

	# One notif-apk at a time: two builds would need 2 x 5 GB.
	def take_lock(self) -> None:
		data_dir = self.paths.data_dir
		if not self.paths.repo_dir.is_dir():
			die(f"{data_dir}/repo does not exist (./deploy.sh runs notif-apk setup, which creates it)")
		try:
			locked = self.host.lock(data_dir)
		except OSError as e:
			die(f"cannot lock {data_dir}: {e.strerror}")
		if not locked:
			die("another notif-apk run is in progress")

	def ensure_image(self, image: str, dockerfile: str) -> None:
		print(f"notif-apk: docker build {image} (cached after the first run)")
		try:
			with (self.paths.fdroid_dir / dockerfile).open("rb") as f:
				status = self.host.call(
					["docker", "build", "--quiet", "--tag", image, "-"], stdin=f, stdout=subprocess.DEVNULL
				)
		except OSError as e:
			print(f"notif-apk: {e}", file=sys.stderr)
			status = 1
		if status != 0:
			die(f"docker build {image} failed (see above)")

	def keys_argv(self, args: Sequence[str], *, writable: bool, options: Sequence[str] = ()) -> list[str]:
		"""A container_keys.py run in the publish image. Only generate and restore get /keys writable."""
		mount = f"type=bind,src={self.paths.keys_dir},dst=/keys" + ("" if writable else ",readonly")
		return [
			"docker", "run", "--rm", "--network", "none",
			"--mount", mount,
			"--mount", f"type=bind,src={self.paths.fdroid_dir},dst=/tool,readonly",
			*options,
			PUBLISH_IMAGE, "python3", "/tool/container_keys.py", *args,
		]  # fmt: skip

	def inspect_keys(self) -> KeyState:
		status, out = self.host.capture(self.keys_argv(["inspect"], writable=False))
		if status != 0:
			die(f"refused: cannot read the keys in {self.paths.keys_dir} (see above); not touching them")
		try:
			return parse_inspection(out)
		except ValueError:
			die(f"unexpected key inspection output: {out}")

	def verify_disk_keys(self, state: Present, pins: Pins) -> None:
		keys_dir = self.paths.keys_dir
		if state.apk != pins.apk:
			die(
				f"refused: the APK key in {keys_dir} has cert SHA-256 {state.apk}, but the pin is {pins.apk};"
				" not touching it (runbook: refusals)"
			)
		if state.repo != pins.repo:
			die(
				f"refused: the repo index key in {keys_dir} has cert SHA-256 {state.repo}, but the pin is {pins.repo};"
				" not touching it (runbook: refusals)"
			)

	@staticmethod
	def report_unpinned(state: Present) -> None:
		print(
			"notif-apk: ################################################################\n"
			"notif-apk: The signing keys are not pinned yet; build and publish refuse\n"
			"notif-apk: until they are. Next, in this order:\n"
			"notif-apk:  1. Back them up. On the PC, in Git Bash, in the repo:\n"
			"notif-apk:       deploy/fdroid/backup-keys.sh\n"
			"notif-apk:  2. Commit the pins, merge, and run ./deploy.sh again:\n"
			f"notif-apk:       echo {state.apk} >>deploy/fdroid/pins/apk-cert.sha256\n"
			f"notif-apk:       echo {state.repo} >>deploy/fdroid/pins/repo-index-cert.sha256\n"
			"notif-apk: The second digest is the repo fingerprint the F-Droid client shows.\n"
			"notif-apk: ################################################################"
		)

	def restore_keys(self, tar: Path, pins: Pins | None) -> None:
		keys_dir = self.paths.keys_dir
		self.take_lock()
		info(f"restoring the signing keys from {tar}")
		argv = self.keys_argv(
			["restore", "/in/backup.tar"],
			writable=True,
			options=[
				"--env", f"APK_CERT_SHA256={pins.apk if pins else ''}",
				"--env", f"REPO_CERT_SHA256={pins.repo if pins else ''}",
				"--mount", f"type=bind,src={tar},dst=/in/backup.tar,readonly",
			],
		)  # fmt: skip
		if self.host.call(argv) != 0:
			die(f"refused: restoring from {tar} failed (see above)")
		state = self.inspect_keys()
		if not isinstance(state, Present):
			die(f"restoring left {keys_dir} {state.word}")
		if pins is not None:
			self.verify_disk_keys(state, pins)
			info(f"restored; the keys in {keys_dir} match the pins")
		else:
			self.report_unpinned(state)
		info(f"{tar} holds the private keys; unless it is your only copy, shred it: shred -u -- {tar}")

	def generate_keys(self) -> None:
		keys_dir = self.paths.keys_dir
		self.take_lock()
		info(f"generating new signing keys in {keys_dir}")
		if self.host.call(self.keys_argv(["generate"], writable=True)) != 0:
			die("generating the keys failed (see above)")
		state = self.inspect_keys()
		if not isinstance(state, Present):
			die(f"generating left {keys_dir} {state.word}")
		self.report_unpinned(state)

	def setup_keys(self, restore: Path | None) -> None:
		"""The key state machine; the runbook has it as a table."""
		keys_dir = self.paths.keys_dir
		pins = self.read_pins()
		match self.inspect_keys():
			case Present() as keys:
				if restore is not None:
					warn(f"--restore ignored: {keys_dir} already holds keys")
				if pins is None:
					self.report_unpinned(keys)
				else:
					self.verify_disk_keys(keys, pins)
					info(f"the keys in {keys_dir} match the pins")
			case Partial(files):
				die(
					f"refused: {keys_dir} holds only {files} of the four key files; not touching it (runbook: refusals)"
				)
			case Absent():
				if restore is not None:
					self.restore_keys(restore, pins)
				elif pins is not None:
					die(
						f"refused: {keys_dir} holds no keys, but the pins are set; restore them with"
						" ./deploy.sh --fdroid-restore <backup tar> (runbook: restore on a fresh VPS)"
					)
				else:
					self.generate_keys()
			case unknown:
				assert_never(unknown)
		pickup = self.paths.pickup
		if pickup.exists(follow_symlinks=False):
			warn(f"{pickup} still holds a copy of the keys; finish deploy/fdroid/backup-keys.sh on the PC, or shred it")

	def cmd_setup(self, args: Sequence[str]) -> None:
		paths = self.paths
		restore: Path | None = None
		match args:
			case ["--restore", tar]:
				restore = Path(tar).resolve()
				if not restore.is_file():
					die(f"not a file: {tar}")
			case []:
				pass
			case _:
				die("usage: notif-apk setup [--restore <tar>]")
		info(f"setup: {paths.keys_dir}, {paths.data_dir}/repo, {paths.link}")
		self.sudo(["install", "-d", "-m", "0700", "-o", "root", "-g", "root", "--", str(paths.keys_dir)])
		self.sudo(
			["install", "-d", "-m", "0755", "-o", "root", "-g", "root", "--", str(paths.data_dir), str(paths.repo_dir)]
		)
		self.sudo(["ln", "-sfT", "--", str(paths.script), str(paths.link)])
		self.ensure_image(PUBLISH_IMAGE, "publish.Dockerfile")
		self.setup_keys(restore)

	def cmd_export_keys(self, args: Sequence[str]) -> None:
		paths = self.paths
		if args:
			die("usage: notif-apk export-keys")
		pickup = paths.pickup
		if pickup.exists(follow_symlinks=False):
			die(f"refused: {pickup} exists, left by an earlier export; shred it, then run this again")
		pins = self.read_pins()
		state = self.inspect_keys()
		if not isinstance(state, Present):
			die(f"refused: {paths.keys_dir} holds no complete key set ({state.word})")
		if pins is not None:
			self.verify_disk_keys(state, pins)
		try:
			fd, tmp = tempfile.mkstemp(prefix=f"{pickup.name}.", dir=pickup.parent)
		except OSError as e:
			die(f"cannot create a file next to {pickup}: {e}")
		try:
			try:
				status = self.host.call(self.keys_argv(["archive"], writable=False), stdout=fd)
			finally:
				os.close(fd)
			if status != 0:
				die("archiving the keys failed (see above)")
			try:
				os.link(tmp, pickup)  # never replaces an existing file
			except OSError as e:
				die(f"cannot create {pickup}: {e.strerror}")
		finally:
			self.host.hold_signals()
			Path(tmp).unlink(missing_ok=True)
		info(f"wrote {pickup} (APK cert {state.apk}, repo index cert {state.repo})")

	def publish(self, pins: Pins, apk: Path) -> None:
		keys_dir = self.paths.keys_dir
		self.check([
			"docker", "run", "--rm", "--name", "notif-apk-publish", "--network", "none",
			"--env", f"APK_CERT_SHA256={pins.apk}",
			"--env", f"REPO_CERT_SHA256={pins.repo}",
			"--mount", f"type=bind,src={self.paths.fdroid_dir},dst=/tool,readonly",
			"--mount", f"type=bind,src={self.paths.repo_dir},dst=/work/repo",
			"--mount", f"type=bind,src={keys_dir}/repo-index.p12,dst=/run/secrets/repo-index.p12,readonly",
			"--mount", f"type=bind,src={keys_dir}/repo-index.pass,dst=/run/secrets/repo-index.pass,readonly",
			"--mount", f"type=bind,src={apk},dst=/in/notif.apk,readonly",
			PUBLISH_IMAGE, "python3", "/tool/publish_apk.py", "/in/notif.apk",
		])  # fmt: skip

	def cmd_build(self, args: Sequence[str]) -> None:
		paths = self.paths
		if len(args) > 1:
			die("usage: notif-apk build [commit]")
		rev = args[0] if args and args[0] else "origin/master"
		if rev.startswith("-"):
			die(f"not a commit: {rev}")
		pins = self.require_pins()
		self.take_lock()

		self.check(["git", "-C", str(paths.checkout), "fetch", "--quiet", "origin"])
		status, commit = self.git("rev-parse", "--verify", "--quiet", f"{rev}^{{commit}}")
		if status != 0:
			die(f"not a commit: {rev}")
		status, version_code = self.git("rev-list", "--count", commit)
		if status != 0:
			raise CommandError(status)
		status, short_sha = self.git("rev-parse", "--short", commit)
		if status != 0:
			raise CommandError(status)
		print(f"notif-apk: building {short_sha}, versionCode {version_code}")

		self.ensure_image(BUILD_IMAGE, "build.Dockerfile")
		self.ensure_image(PUBLISH_IMAGE, "publish.Dockerfile")

		paths.work_root.mkdir(parents=True, exist_ok=True)
		work = Path(tempfile.mkdtemp(prefix="build.", dir=paths.work_root))
		try:
			src = work / "src"
			out = work / "out"
			self.check(["git", "-C", str(paths.checkout), "worktree", "add", "--detach", "--quiet", str(src), commit])
			out.mkdir()
			self.check([
				"docker", "run", "--rm", "--name", "notif-apk-build",
				"--memory", "5g", "--memory-swap", "5g", "--cpus", "3",
				"--mount", f"type=bind,src={src},dst=/src,readonly",
				"--mount", f"type=bind,src={out},dst=/out",
				"--mount", f"type=bind,src={paths.fdroid_dir},dst=/tool,readonly",
				"--mount", f"type=bind,src={paths.keys_dir}/apk.p12,dst=/run/secrets/apk.p12,readonly",
				"--mount", f"type=bind,src={paths.keys_dir}/apk.pass,dst=/run/secrets/apk.pass,readonly",
				"--mount", "type=volume,src=notif-apk-gradle,dst=/root/.gradle",
				"--mount", "type=volume,src=notif-apk-pub,dst=/root/.pub-cache",
				BUILD_IMAGE, "bash", "/tool/container-build.sh", version_code, short_sha,
			])  # fmt: skip
			self.publish(pins, out / f"notif-{version_code}-{short_sha}.apk")
		finally:
			self.host.hold_signals()
			self.remove_work(work)

	def remove_work(self, work: Path) -> None:
		src = work / "src"
		if src.exists():
			status = self.host.call(["git", "-C", str(self.paths.checkout), "worktree", "remove", "--force", str(src)])
			if status != 0:
				warn(f"could not remove worktree {src}")

		def report(_function: object, path: str, error: BaseException) -> None:
			warn(f"could not remove {path}: {error}")

		shutil.rmtree(work, onexc=report)

	def cmd_publish(self, args: Sequence[str]) -> None:
		if len(args) != 1:
			die("usage: notif-apk publish <apk>")
		apk = Path(args[0]).resolve()
		if not apk.is_file():
			die(f"not a file: {args[0]}")
		pins = self.require_pins()
		self.take_lock()
		self.ensure_image(PUBLISH_IMAGE, "publish.Dockerfile")
		self.publish(pins, apk)


def main(argv: Sequence[str], environ: Mapping[str, str], host: Host, *, script: Path, as_root: bool) -> int:
	app = NotifApk(Paths.from_env(script, environ), host, as_root=as_root)
	command, args = (argv[1], argv[2:]) if len(argv) > 1 else ("", [])
	try:
		match command:
			case "setup":
				app.cmd_setup(args)
			case "build":
				app.cmd_build(args)
			case "publish":
				app.cmd_publish(args)
			case "export-keys":
				app.cmd_export_keys(args)
			case "-h" | "--help" | "help":
				print(USAGE, end="")
			case _:
				print(USAGE, end="", file=sys.stderr)
				return 2
	except FatalError as e:
		print(f"notif-apk: {e}", file=sys.stderr)
		return 1
	except CommandError as e:
		return e.status
	except Interrupted as e:
		return 128 + e.signum
	return 0


def run() -> int:
	# Line-buffered, so these lines and the commands' output stay in order in a
	# pipe; surrogateescape writes a non-UTF-8 path back as the bytes it was.
	for stream in (sys.stdout, sys.stderr):
		if isinstance(stream, io.TextIOWrapper):
			stream.reconfigure(line_buffering=True, errors="surrogateescape")
	host = LocalHost()
	host.install_signal_handlers()
	# Symlinks resolved: setup points the link at this file, and the checkout is two levels up.
	status = main(sys.argv, os.environ, host, script=Path(__file__).resolve(), as_root=os.geteuid() == 0)
	host.hold_signals()
	if host.pending is not None:
		return 128 + host.pending
	return status


if __name__ == "__main__":
	sys.exit(run())
