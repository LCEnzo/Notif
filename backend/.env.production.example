# ── Notif Production Environment ──────────────────────────────────
# Copy to backend/.env and edit:
#   cp backend/.env.production.example backend/.env
# Or use the bootstrap script (recommended):
#   bash deploy/write-prod-env.sh
#
# ⚠️ DOCKER COMPOSE $ INTERPOLATION WARNING ─────────────────────────────────
# Docker Compose interpolates $VAR and ${VAR} inside env_file values.  If
# DJANGO_SECRET_KEY or any value contains a literal $, Compose will try to
# expand it as a variable — producing warnings like:
#   The "abc123" variable is not set. Defaulting to a blank string.
# and silently mutating the value.
#
# To avoid this:
#   • Generate secrets with openssl rand -hex 48 — no $ characters.
#   • If you MUST include a $, escape it as $$ in the env file.
#   • The bootstrap script (deploy/write-prod-env.sh) generates hex-only
#     secrets, which are safe.
# ────────────────────────────────────────────────────────────────────────────

# ── environment ──────────────────────────────────────────────────
NOTIF_ENV=production

# ── core ─────────────────────────────────────────────────────────
DEBUG=false
# REQUIRED. Generate with: openssl rand -hex 48
# Never commit real secrets.  Prefer the bootstrap script:
#   bash deploy/write-prod-env.sh
DJANGO_SECRET_KEY=<generate-with-openssl-rand-hex-48>
# Comma-separated hostnames. Must include your domain.
ALLOWED_HOSTS=notif.lcenzo.com
# Comma-separated origins for CORS (browser requests from your frontend).
CORS_ALLOWED_ORIGINS=https://notif.lcenzo.com
# Comma-separated scheme+host origins that POSTs are accepted from.
# Required behind an HTTPS reverse proxy.
CSRF_TRUSTED_ORIGINS=https://notif.lcenzo.com
# URL prefix for Django admin.  Change from the default to reduce
# brute-force login noise.  Must end with /.
DJANGO_ADMIN_URL=<random-admin-path>/
# Path to SQLite database file.
SQLITE_PATH=/app/data/db.sqlite3

# ── static files ─────────────────────────────────────────────────
STATIC_ROOT=staticfiles

# ── latency middleware (production — no artificial latency) ──────
DEV_API_LATENCY_MS=0
DEV_API_LATENCY_JITTER_MS=0

# ── build info (exposed via /api/v1/monitoring/status/) ──────────
VERSION=0.2.0
# Injected by deploy script (deploy/write-prod-env.sh) via:
#   GIT_HASH=$(git rev-parse --short HEAD)
GIT_HASH=<set-by-deploy-script>
