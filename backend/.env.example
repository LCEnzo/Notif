# ── environment ──────────────────────────────────────────────────
# local | staging | production
NOTIF_ENV=local

# ── core ─────────────────────────────────────────────────────────
# Set to false in production.
DEBUG=true
# REQUIRED. Generate with: python manage.py regenerate_secret_key
DJANGO_SECRET_KEY=change-me
# Comma-separated hostnames. Must include your domain in production.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Comma-separated origins for CORS (browser requests from other domains).
# In dev, CORS_ALLOW_ALL_ORIGINS is true so this is ignored.
# In production, set to your frontend URL, e.g. https://notif.example.com
CORS_ALLOWED_ORIGINS=
# Comma-separated scheme+host origins Django accepts POSTs from.
# Required behind an HTTPS reverse proxy (admin login, session-auth endpoints).
# In production, set to your site origin, e.g. https://notif.example.com
CSRF_TRUSTED_ORIGINS=
# URL prefix for the Django admin (must end with '/'). Override in
# production with a non-guessable path to cut brute-force log noise.
DJANGO_ADMIN_URL=admin/
# Path to SQLite database file. Can be absolute or relative.
SQLITE_PATH=db.sqlite3

# Directory where ``collectstatic`` gathers static files for production serving.
# Usually doesn't need changing — managed by Docker volume.
STATIC_ROOT=staticfiles

# ── runserver (dev only, ignored by gunicorn) ────────────────────
BACKEND_PORT=8000
RUNSERVER_HOST=127.0.0.1

# ── dev bootstrap login (dev only, ignored when DEBUG=false) ─────
DEV_BOOTSTRAP_LOGIN_ENABLED=true
DEV_BOOTSTRAP_USERNAME=LCEnzo
DEV_BOOTSTRAP_PASSWORD=change-me
DEV_BOOTSTRAP_EMAIL=lcenzo@notif.local
DEV_BOOTSTRAP_NAME=LCEnzo

# ── dev latency middleware (simulates network lag in dev) ────────
DEV_API_LATENCY_MS=100
DEV_API_LATENCY_JITTER_MS=50

# ── email (Resend) ─────────────────────────────────────────────────
# API key from https://resend.com/api-keys (starts with re_).
# Leave empty to disable email sending (code is logged instead).
RESEND_API_KEY=
# "From" address for system emails. Must be verified in Resend dashboard.
EMAIL_FROM=Notif <notif@notif.lcenzo.com>
# Webhook secret for Resend event notifications (optional).
RESEND_WEBHOOK_SECRET=
# Resend audience ID for contact management (optional).
RESEND_AUDIENCE_ID=
# Redirect URL for email confirmation links (optional).
CONFIRM_REDIRECT_URL=https://notif.lcenzo.com
# Override at deploy time to pin the deployed version.
VERSION=0.2.0
# Git commit hash of the deployed code. Set in CI/deploy script.
GIT_HASH=dev
