# ── environment ──────────────────────────────────────────────────
# local | staging | production
NOTIF_ENV=local

# ── core ─────────────────────────────────────────────────────────
# Set to false in production.
DEBUG=true
# REQUIRED. Generate with: python manage.py regenerate_secret_key
DJANGO_SECRET_KEY=change-me
# Comma-separated hostnames. Must include your domain in production.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Comma-separated origins for CORS (browser requests from other domains).
# In dev, CORS_ALLOW_ALL_ORIGINS is true so this is ignored.
# In production, set to your frontend URL, e.g. https://notif.example.com
CORS_ALLOWED_ORIGINS=
# Path to SQLite database file. Can be absolute or relative.
SQLITE_PATH=db.sqlite3

# Directory where ``collectstatic`` gathers static files for production serving.
# Usually doesn't need changing — managed by Docker volume.
STATIC_ROOT=staticfiles

# ── runserver (dev only, ignored by gunicorn) ────────────────────
BACKEND_PORT=8000
RUNSERVER_HOST=127.0.0.1

# ── dev bootstrap login (dev only, ignored when DEBUG=false) ─────
DEV_BOOTSTRAP_LOGIN_ENABLED=true
DEV_BOOTSTRAP_USERNAME=LCEnzo
DEV_BOOTSTRAP_PASSWORD=change-me
DEV_BOOTSTRAP_EMAIL=lcenzo@notif.local
DEV_BOOTSTRAP_NAME=LCEnzo

# ── dev latency middleware (simulates network lag in dev) ────────
DEV_API_LATENCY_MS=100
DEV_API_LATENCY_JITTER_MS=50
