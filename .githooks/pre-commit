#!/usr/bin/env bash
# Pre-commit hook: scan staged files for secrets with detect-secrets.
#
# The staged BYTES are scanned, not the working tree: with a partially staged
# file the two differ, and the commit is the staged version. The index is
# materialised into a temp dir via git checkout-index and the scan runs there.
# The baseline is read from the index too, so a regenerated baseline must be
# staged (git add .secrets.baseline) to take effect.
#
# Secrets already in the baseline (known or audited false positives) are
# allowed; any new secret triggers a reject.
#
# Bypass: git -c core.hooksPath=/dev/null commit
set -euo pipefail

# ACMRT, not ACM: a renamed (R) or type-changed (T) file can carry edited
# content, and rename detection is on by default - a rename+edit would be
# classified R and silently skip the scan. D stays excluded; there is nothing
# to scan in a deletion.
mapfile -d "" -t staged < <(git diff --cached --name-only -z --diff-filter=ACMRT)
[ "${#staged[@]}" -eq 0 ] && exit 0

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# detect-secrets-hook shells out to git, and the scan below runs inside the
# staging dir - not a repository. Point git at the repo via env so those calls
# resolve regardless of cwd. Linked-worktree commits already get an absolute
# GIT_DIR from git itself; this makes main-checkout commits behave the same.
GIT_DIR=$(git rev-parse --absolute-git-dir)
export GIT_DIR

staging_dir=$(mktemp -d)
trap 'rm -rf "$staging_dir"' EXIT

git checkout-index --prefix="$staging_dir/" -- "${staged[@]}" .secrets.baseline

if ! (cd "$staging_dir" && uv --project "$repo_root/backend" run detect-secrets-hook --baseline .secrets.baseline "${staged[@]}"); then
	echo ""
	echo "--- detect-secrets found potential secrets in staged files ---"
	echo "If these are false positives, regenerate the baseline, re-audit the"
	echo "new entries, and stage it:"
	echo "  uv --project backend run detect-secrets scan > .secrets.baseline"
	echo "  uv --project backend run detect-secrets audit .secrets.baseline"
	echo "  git add .secrets.baseline"
	exit 1
fi
